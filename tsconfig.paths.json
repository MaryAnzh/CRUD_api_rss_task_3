{
  "compilerOptions": {
    "baseUrl": "./src",
    "paths": {
      "~constants": [
        "constants/index.ts"
      ],
      "~constants/*": [
        "constants/*"
      ],
      "~types": [
        "types/index.ts"
      ],
      "~types/*": [
        "types/*"
      ],
      "~db": [
        "db/index.ts"
      ],
      "~db/*": [
        "db/*"
      ],
      "~routes": [
        "routes/index.ts"
      ],
      "~routes/*": [
        "routes/*"
      ],
      "~controllers": [
        "controllers/index.ts"
      ],
      "~controllers/*": [
        "controllers/*"
      ],
      "~utils/*": [
        "utils/*"
      ]
    }
  }
}